# 生产配置：三个子域名，证书放在 deploy/certs/<域名>.pem 和 <域名>.key
#   www.${DOMAIN}   用户端 H5，只代理 /api/app
#   admin.${DOMAIN} 管理系统，只代理 /api/admin
#   api.${DOMAIN}   小程序接口域名，只代理 /api/app
# 登录 / 注册限流：每个 IP 每分钟 10 次，允许突发 10 次，防暴力破解密码
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_status 429;

# HTTP：证书申请验证 + 其余跳转 HTTPS
server {
    listen 80;
    server_name www.${DOMAIN} admin.${DOMAIN} api.${DOMAIN} ${DOMAIN};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# 裸域名跳转到 www
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    ssl_certificate     /etc/nginx/certs/www.${DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/www.${DOMAIN}.key;
    return 301 https://www.${DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};
    ssl_certificate     /etc/nginx/certs/www.${DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/www.${DOMAIN}.key;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/common.conf;
    add_header Strict-Transport-Security "max-age=15552000" always;
    root /usr/share/nginx/www;

    location /api/app/auth/ {
        limit_req zone=auth burst=10 nodelay;
        include /etc/nginx/snippets/proxy.conf;
    }
    location /api/app/ {
        include /etc/nginx/snippets/proxy.conf;
    }
    location /api/ {
        return 404;
    }
    include /etc/nginx/snippets/uploads.conf;
    include /etc/nginx/snippets/spa.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name admin.${DOMAIN};
    ssl_certificate     /etc/nginx/certs/admin.${DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/admin.${DOMAIN}.key;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/common.conf;
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Frame-Options DENY always;
    root /usr/share/nginx/admin;

    location /api/admin/auth/login {
        limit_req zone=auth burst=10 nodelay;
        include /etc/nginx/snippets/proxy.conf;
    }
    location /api/admin/ {
        include /etc/nginx/snippets/proxy.conf;
    }
    location /api/ {
        return 404;
    }
    include /etc/nginx/snippets/uploads.conf;
    include /etc/nginx/snippets/spa.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.${DOMAIN};
    ssl_certificate     /etc/nginx/certs/api.${DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/api.${DOMAIN}.key;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/common.conf;
    add_header Strict-Transport-Security "max-age=15552000" always;

    location /api/app/auth/ {
        limit_req zone=auth burst=10 nodelay;
        include /etc/nginx/snippets/proxy.conf;
    }
    location /api/app/ {
        include /etc/nginx/snippets/proxy.conf;
    }
    include /etc/nginx/snippets/uploads.conf;
    location / {
        return 404;
    }
}
