# 复制为 .env 后填写；.env 不要提交到代码仓库
# 备案通过的主域名（不带 www），会使用 www./admin./api. 三个子域名
DOMAIN=example.com

# 数据库与 Redis 密码：请用随机强密码，例如 openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=

# 首次启动时创建的超级管理员；生产环境不允许使用默认密码 admin123
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=

# https：正式环境（需先放好证书）；http：备案/证书下来前内部测试
NGINX_MODE=https
HTTP_PORT=80
HTTPS_PORT=443

# 2C4G 服务器默认即可
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
