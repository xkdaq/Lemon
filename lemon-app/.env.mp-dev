# 微信小程序本地联调（npm run dev:mp-weixin 使用 --mode mp-dev）
# 默认连线上接口；连本机后端时新建 .env.mp-dev.local（已 gitignore）覆盖成局域网地址，例如：
#   VITE_API_BASE=http://192.168.x.x:8081/api/app
#   VITE_ASSET_BASE=http://192.168.x.x:8081
# 注意：不要建 .env.mp.local，它会覆盖正式构建（build:mp-weixin）的接口地址
VITE_API_BASE=https://api.lemonsxu.top/api/app
VITE_ASSET_BASE=https://api.lemonsxu.top
