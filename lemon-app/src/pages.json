{
  "pages": [
    { "path": "pages/index/index", "style": { "navigationBarTitleText": "Lemon 刷题", "enablePullDownRefresh": true } },
    { "path": "pages/bank/list", "style": { "navigationBarTitleText": "题库" } },
    { "path": "pages/bank/detail", "style": { "navigationBarTitleText": "题库" } },
    { "path": "pages/chapter/list", "style": { "navigationBarTitleText": "章节" } },
    { "path": "pages/practice/index", "style": { "navigationBarTitleText": "做题", "disableScroll": false } },
    { "path": "pages/practice/result", "style": { "navigationBarTitleText": "练习结果" } },
    { "path": "pages/favorite/index", "style": { "navigationBarTitleText": "收藏集", "enablePullDownRefresh": true } },
    { "path": "pages/wrong/index", "style": { "navigationBarTitleText": "错题集", "enablePullDownRefresh": true } },
    { "path": "pages/collection/list", "style": { "navigationBarTitleText": "题目列表" } },
    { "path": "pages/punch/list", "style": { "navigationBarTitleText": "每日打卡", "enablePullDownRefresh": true } },
    { "path": "pages/punch/detail", "style": { "navigationBarTitleText": "打卡" } },
    { "path": "pages/settings/index", "style": { "navigationBarTitleText": "设置" } },
    { "path": "pages/profile/index", "style": { "navigationBarTitleText": "个人信息" } },
    { "path": "pages/settings/records", "style": { "navigationBarTitleText": "清除做题记录" } },
    { "path": "pages/settings/password", "style": { "navigationBarTitleText": "修改密码" } },
    { "path": "pages/restore/index", "style": { "navigationBarTitleText": "恢复错题" } },
    { "path": "pages/activate/index", "style": { "navigationBarTitleText": "我的模块" } },
    { "path": "pages/note/list", "style": { "navigationBarTitleText": "我的笔记" } },
    { "path": "pages/note/detail", "style": { "navigationBarTitleText": "笔记" } },
    { "path": "pages/doc/index", "style": { "navigationBarTitleText": "" } },
    { "path": "pages/service/index", "style": { "navigationBarTitleText": "联系客服" } },
    { "path": "pages/feedback/index", "style": { "navigationBarTitleText": "意见反馈" } },
    { "path": "pages/recite/index", "style": { "navigationBarTitleText": "背诵", "enablePullDownRefresh": true } },
    { "path": "pages/recite/seq", "style": { "navigationBarTitleText": "按套背" } },
    { "path": "pages/recite/points", "style": { "navigationBarTitleText": "考点" } },
    { "path": "pages/recite/dist", "style": { "navigationBarTitleText": "易混辨析" } },
    { "path": "pages/recite/traps", "style": { "navigationBarTitleText": "错误说法" } },
    { "path": "pages/mine/index", "style": { "navigationBarTitleText": "我的" } },
    { "path": "pages/login/index", "style": { "navigationBarTitleText": "登录" } }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "Lemon 刷题",
    "navigationBarBackgroundColor": "@navBgColor",
    "backgroundColor": "@bgColor",
    "maxWidth": 750,
    "rpxCalcMaxDeviceWidth": 750,
    "rpxCalcBaseDeviceWidth": 375
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "fontSize": "16px",
    "height": "56px",
    "list": [
      // 小程序按 theme.json 自动切换深色图标；H5 不支持图标变量，用固定路径，深色时由 utils/theme.ts 的 applyTabBar 换图标
      // #ifdef MP-WEIXIN
      { "pagePath": "pages/index/index", "text": "首页", "iconPath": "@tabHomeIcon", "selectedIconPath": "@tabHomeActiveIcon" },
      { "pagePath": "pages/recite/index", "text": "背诵", "iconPath": "@tabReciteIcon", "selectedIconPath": "@tabReciteActiveIcon" },
      { "pagePath": "pages/mine/index", "text": "我的", "iconPath": "@tabMineIcon", "selectedIconPath": "@tabMineActiveIcon" }
      // #endif
      // #ifndef MP-WEIXIN
      { "pagePath": "pages/index/index", "text": "首页", "iconPath": "static/tabbar/home.png", "selectedIconPath": "static/tabbar/home-active.png" },
      { "pagePath": "pages/recite/index", "text": "背诵", "iconPath": "static/tabbar/recite.png", "selectedIconPath": "static/tabbar/recite-active.png" },
      { "pagePath": "pages/mine/index", "text": "我的", "iconPath": "static/tabbar/mine.png", "selectedIconPath": "static/tabbar/mine-active.png" }
      // #endif
    ]
  }
}
